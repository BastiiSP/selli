<?xml version="1.0" encoding="utf-8"?>
<!-- Responsives Homescreen-Widget mit drei Höhenstufen. Die Default-Platzierung bleibt
     eine Zelle hoch; updatePeriodMillis=0, weil data/widget per WorkManager aktualisiert. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="60dp"
    android:maxResizeWidth="360dp"
    android:maxResizeHeight="240dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
